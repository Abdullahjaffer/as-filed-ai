{
  "name": "filing-desk",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @filing-desk/web --filter @filing-desk/api dev",
    "dev:web": "pnpm --filter @filing-desk/web dev",
    "dev:api": "pnpm --filter @filing-desk/api dev",
    "build": "pnpm -r --if-present build",
    "db:push": "pnpm --filter @filing-desk/db push",
    "ingest": "pnpm --filter @filing-desk/ingest ingest",
    "ingest:reparse": "pnpm --filter @filing-desk/ingest reparse",
    "ingest:decode": "pnpm --filter @filing-desk/ingest decode-stored",
    "embed": "pnpm --filter @filing-desk/ingest embed",
    "eval": "pnpm --filter @filing-desk/ingest eval"
  }
}
